<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Front-end nuevo de la FEP: HTML/CSS/JS estático en wwwroot servido por ASP.NET Core.
    No accede a la base de datos: todo el contenido llega de FEP.Api (o de wwwroot/mock en modo prototipo).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FEP.Web</RootNamespace>
    <AssemblyName>FEP.Web</AssemblyName>
  </PropertyGroup>

</Project>
